extends layout
block style
  link(rel='stylesheet', href='assets/css/shop.style.css')
  link(rel='stylesheet', href='./style/product.css')
block content
  // === Shop Product ===
  .shop-product
    // Breadcrumbs v5
    .container
      ul.breadcrumb-v5
        li
          a(href='product.html') 產品介紹
        li.active 9938亮面戰車系列(限量雙色)
    // End Breadcrumbs v5
    .container
      .row
        .col-md-6
          .case-product
            .image(name='9938dual', value='1')
            .product-color-text.product-text 深藍綠/霧黑
        .col-md-6
          .shop-product-heading
            h2 9938亮面戰車系列(限量雙色)
          br
          p.shop-product-desc 限量雙色，正面為亮面，背面為霧面。
          h3.shop-product-title 顏色
            span.product-color-text 深藍綠/霧黑
          ul#color9938dual.list-inline.product-color.margin-bottom-30
            li(title='深藍綠/霧黑')
              input#color-1(type='radio', name='color', value='1', checked='')
              label(for='color-1')
            li(title='亮紅/霧黑')
              input#color-2(type='radio', name='color', value='2')
              label(for='color-2')
            li(title='灰白/霧黑')
              input#color-3(type='radio', name='color', value='3')
              label(for='color-3')
            li(title='檸檬綠/霧黑')
              input#color-4(type='radio', name='color', value='4')
              label(for='color-4')
            li(title='亮青藍/霧黑')
              input#color-5(type='radio', name='color', value='5')
              label(for='color-5')
            li(title='俏彩粉/霧黑')
              input#color-6(type='radio', name='color', value='6')
              label(for='color-6')
            li(title='深寶藍/霧黑')
              input#color-7(type='radio', name='color', value='7')
              label(for='color-7')
          h3.shop-product-title 尺寸
          ul.list-inline.product-size.margin-bottom-30
            li(title='27吋')
              label(for='size-1') 27吋
            li(title='29吋')
              label(for='size-2') 29吋
  // === End Shop Product ===

  .content-md.container
    .tab-v6
      ul.nav.nav-tabs(role='tablist')
        li.active
          a(href='#specifications', role='tab', data-toggle='tab') 產品介紹
      .tab-content
        #specifications.tab-pane.fade.in.active
          h2 材質
          p ABS塑鋼，PC(透明防彈玻璃材質)三層複合式箱殼材料獨一無二本體更耐撞，重擊後不易白化。

          h2 尺寸
          table.table.table-striped
            thead
              tr
                th 吋數
                th 長 h(cm)
                th 寬 w(cm)
                th 深 dp(cm)
                th 重量(kg)
                th 建議售價
                th 備註
            tbody
              tr
                td 27 吋
                td 65
                td 45
                td 31
                td 5.5
                td NT 10,220
                td 5~7天適用
              tr
                td 29 吋
                td 71
                td 51
                td 32
                td 6.1
                td NT 10,900
                td 1~2週適用
          h2.margin-bottom-30 產品特色
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/9938雙色/側面-01.png')
            .col-md-6.feature-img
              h3 限量雙色設計
              ul
                li 正面採亮面材質，呈現光滑質感。
                li 背面採霧面材質，耐磨防刮。
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/9938雙色/側面-02.png')
            .col-md-6.feature-img
              h3 箱殼
              ul
                li 三層複合式材料，表層採防彈玻璃材質，使本體更耐壓、耐撞不易白化。

block append js
  script(src='./js/product.js')
