extends layout
block style
  link(rel='stylesheet', href='assets/css/shop.style.css')
  link(rel='stylesheet', href='./style/product.css')
block content
  // === Shop Product ===
  .shop-product
    // Breadcrumbs v5
    .container
      ul.breadcrumb-v5
        li
          a(href='product.html') 產品介紹
        li.active 限量款9928亮面戰車系列(珠光變色)
    // End Breadcrumbs v5
    .container
      .row
        .col-md-6
          .case-product
            .image(name='9928', value='1')
            .product-color-text.product-text 珠光白
        .col-md-6
          .shop-product-heading
            h2 限量款9928亮面戰車系列(珠光變色)
          br
          h3.shop-product-title 顏色
            span.product-color-text 珠光白
          ul#color9928.list-inline.product-color.margin-bottom-30
            li(title='珠光白')
              input#color-1(type='radio', name='color', value='1', checked='')
              label(for='color-1')
            li(title='水泥灰')
              input#color-2(type='radio', name='color', value='2')
              label(for='color-2')
            li(title='亮橘粉')
              input#color-3(type='radio', name='color', value='3')
              label(for='color-3')
            li(title='草綠')
              input#color-4(type='radio', name='color', value='4')
              label(for='color-4')
            li(title='珠光青藍')
              input#color-5(type='radio', name='color', value='5')
              label(for='color-5')
          h3.shop-product-title 尺寸
          ul.list-inline.product-size.margin-bottom-30
            li(title='27吋')
              label(for='size-1') 27吋
            li(title='29吋')
              label(for='size-2') 29吋
  // === End Shop Product ===

  .content-md.container
    .tab-v6
      ul.nav.nav-tabs(role='tablist')
        li.active
          a(href='#specifications', role='tab', data-toggle='tab') 產品介紹
      .tab-content
        #specifications.tab-pane.fade.in.active
          h2 材質
          p ABS塑鋼，PC(透明防彈玻璃材質)三層複合式箱殼材料，獨一無二本體更耐撞，重擊後不易白化。

          h2 尺寸
          table.table.table-striped
            thead
              tr
                th 吋數
                th 長 h(cm)
                th 寬 w(cm)
                th 深 dp(cm)
                th 重量(kg)
                th 建議售價
                th 備註
            tbody
              tr
                td 27 吋
                td 65
                td 45
                td 30
                td 5.1
                td NT 11,300
                td 5~7天適用
              tr
                td 29 吋
                td 71
                td 51
                td 31
                td 5.8
                td NT 12,000
                td 1~2週適用
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/9928/0-吊裡-1 (1).png')
            .col-md-6.feature-img
              img(src='./img/9928/0-吊裡-2.png')

block append js
  script(src='./js/product.js')
