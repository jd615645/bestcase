extends layout
block style
  link(rel='stylesheet', href='assets/css/shop.style.css')
  link(rel='stylesheet', href='./style/product.css')
block content
  // === Shop Product ===
  .shop-product
    // Breadcrumbs v5
    .container
      ul.breadcrumb-v5
        li
          a(href='product.html') 產品介紹
        li.active 2510霧面戰車系列
    // End Breadcrumbs v5
    .container
      .row
        .col-md-6
          .case-product
            .image(name='2510mist', value='1')
            .product-color-text.product-text 霧杏粉
        .col-md-6
          .shop-product-heading
            h2 2510霧面戰車系列
          br
          h3.shop-product-title 顏色
            span.product-color-text 霧杏粉
          ul#color2510mist.list-inline.product-color.margin-bottom-30
            li(title='霧杏粉')
              input#color-1(type='radio', name='color', value='1', checked='')
              label(for='color-1')
            li(title='霧暮金')
              input#color-2(type='radio', name='color', value='2')
              label(for='color-2')
            li(title='霧可可')
              input#color-3(type='radio', name='color', value='3')
              label(for='color-3')
            li(title='霧沙棕')
              input#color-4(type='radio', name='color', value='4')
              label(for='color-4')
            li(title='霧岩鐵')
              input#color-5(type='radio', name='color', value='5')
              label(for='color-5')
            li(title='霧碧藍')
              input#color-6(type='radio', name='color', value='6')
              label(for='color-6')
            li(title='霧炫藍')
              input#color-7(type='radio', name='color', value='7')
              label(for='color-7')
          h3.shop-product-title 尺寸
          ul.list-inline.product-size.margin-bottom-30
            li(title='24吋')
              label(for='size-1') 24吋
            li(title='27吋')
              label(for='size-2') 27吋
            li(title='29吋')
              label(for='size-3') 29吋
  // === End Shop Product ===

  .content-md.container
    .tab-v6
      ul.nav.nav-tabs(role='tablist')
        li.active
          a(href='#specifications', role='tab', data-toggle='tab') 產品介紹
      .tab-content
        #specifications.tab-pane.fade.in.active
          h2 材質
          p ABS塑鋼，PC(透明防彈玻璃材質)三層複合式箱殼材料，獨一無二本體更耐撞，重擊後不易白化。

          h2 尺寸（不含輪子）
          table.table.table-striped
            thead
              tr
                th 吋數
                th 長 h(cm)
                th 寬 w(cm)
                th 深 dp(cm)
                th 重量(kg)
                th 建議售價
                th 備註
            tbody
              tr
                td 24 吋
                td 59
                td 42
                td 29
                td 4.8
                td NT 9,080
                td 3~5天適用
              tr
                td 27 吋
                td 65
                td 45
                td 31
                td 5.4
                td NT 10,220
                td 5~7天適用
              tr
                td 29 吋
                td 71
                td 51
                td 32
                td 5.8
                td NT 10,900
                td 1~2週適用
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/2510_霧面/零件-內裝-01.png')
            .col-md-6.feature-img
              img(src='./img/2510_霧面/零件-內裝-02.png')

block append js
  script(src='./js/product.js')
