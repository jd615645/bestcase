extends layout
block style
  link(rel='stylesheet', href='assets/css/shop.style.css')
  link(rel='stylesheet', href='./style/product.css')
block content
  // === Shop Product ===
  .shop-product
    // Breadcrumbs v5
    .container
      ul.breadcrumb-v5
        li
          a(href='product.html') 產品介紹
        li.active 8828前開式多功能擴充箱
    // End Breadcrumbs v5
    .container
      .row
        .col-md-6
          .case-product
            .image(name='8828', value='1')
            .product-color-text.product-text 閃焰紅
        .col-md-6
          .shop-product-heading
            h2 8828前開式多功能擴充箱
          br
          h3.shop-product-title 顏色
            span.product-color-text 閃焰紅
          ul#color8828.list-inline.product-color.margin-bottom-30
            li(title='閃焰紅')
              input#color-1(type='radio', name='color', value='1', checked='')
              label(for='color-1')
            li(title='俏彩粉')
              input#color-2(type='radio', name='color', value='2')
              label(for='color-2')
            li(title='玫瑰粉紫')
              input#color-3(type='radio', name='color', value='3')
              label(for='color-3')
            li(title='魅力咖啡')
              input#color-4(type='radio', name='color', value='4')
              label(for='color-4')
            li(title='蘋果綠')
              input#color-5(type='radio', name='color', value='5')
              label(for='color-5')
            li(title='鑽石黑')
              input#color-6(type='radio', name='color', value='6')
              label(for='color-6')
            li(title='鈦金銀')
              input#color-7(type='radio', name='color', value='7')
              label(for='color-7')
          h3.shop-product-title 尺寸
          ul.list-inline.product-size.margin-bottom-30
            li(title='18吋')
              label(for='size-1') 18吋
  // === End Shop Product ===

  .content-md.container
    .tab-v6
      ul.nav.nav-tabs(role='tablist')
        li.active
          a(href='#specifications', role='tab', data-toggle='tab') 產品介紹
      .tab-content
        #specifications.tab-pane.fade.in.active
          h2 材質
          p ABS塑鋼，PC(透明防彈玻璃材質)三層複合式箱殼材料獨一無二本體更耐撞，重擊後不易白化。

          h2 尺寸
          table.table.table-striped
            thead
              tr
                th 吋數
                th 長 h(cm)
                th 寬 w(cm)
                th 深 dp(cm)
                th 重量(kg)
                th 建議售價
                th 備註
            tbody
              tr
                td 18 吋
                td 49
                td 35
                td 25
                td 3.2
                td NT 6,880
                td 1~3天適用
          h2.margin-bottom-30 產品特色
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/8828/幻燈片04-前開面.png')
            .col-md-6.feature-img
              h3 前開式設計
              ul
                li 正面前開拉鍊設計，不需開箱即可取放常用物品。
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/8828/幻燈片05-擴充面.png')
            .col-md-6.feature-img
              h3 擴充功能
              ul
                li 拉鍊擴充設計，可增加行李容量，出遊採購不用擔心空間不夠。
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/8828/幻燈片06-鎖頭面.png')
            .col-md-6.feature-img
              h3 TSA 國際海關鎖頭
              ul
                li TSA 鎖頭為美國海關簽約認可之行李箱鎖頭。
                li 進出美國，行李箱可直接上鎖，避免海關安檢時破壞鎖頭造成旅遊不便。
          .row.feature.margin-bottom-30
            .col-md-6.feature-img
              img(src='./img/8828/幻燈片02-背面.png')
            .col-md-6.feature-img
              h3 箱殼
              ul
                li 三層複合式材料，表層採防彈玻璃材質，使本體更耐壓、耐撞不易白化。

block append js
  script(src='./js/product.js')
